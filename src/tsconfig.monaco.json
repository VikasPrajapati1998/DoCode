{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": [
			"@webgpu/types",
			"trusted-types",
			"wicg-file-system-access"
		],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"removeComments": false,
		"preserveConstEnums": true,
		"target": "ES2024",
		"sourceMap": false,
		"declaration": true,
		"skipLibCheck": true
	},
	"include": [
		"typings/css.d.ts",
		"typings/thenable.d.ts",
		"typings/docode-globals-product.d.ts",
		"typings/docode-globals-nls.d.ts",
		"typings/editContext.d.ts",
		"typings/base-common.d.ts",
		"do/monaco.d.ts",
		"do/editor/*",
		"do/base/common/*",
		"do/base/browser/*",
		"do/platform/*/common/*",
		"do/platform/*/browser/*"
	],
	"exclude": [
		"node_modules/*",
		"do/platform/files/browser/htmlFileSystemProvider.ts",
		"do/platform/files/browser/webFileSystemAccess.ts",
		"do/platform/telemetry/*",
		"do/platform/assignment/*",
		"do/platform/terminal/*",
		"do/platform/externalTerminal/*"
	]
}
