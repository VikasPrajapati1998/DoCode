{
	"name": "@docode/hubrpc",
	"version": "0.0.2-20",
	"type": "module",
	"license": "MIT",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@docode/source": "./src/index.ts",
			"default": "./dist/index.js"
