			"default": "./dist/node.js"
		},
		"./web": {
			"@docode/source": "./src/web.ts",
			"default": "./dist/web.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/"
	],
	"sideEffects": false,
	"peerDependencies": {
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@hpke/core": "^1.9.0",
		"ws": "^8.18.0"
	},
