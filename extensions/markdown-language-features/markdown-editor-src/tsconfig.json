{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "..",
		"outDir": "./dist/",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [
			"es2024",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"docode-webview"
		],
		"typeRoots": [
			"../node_modules/@types"
		],
		"preserveSymlinks": true,
		"paths": {
			"@vscode/markdown-editor": [
				"../node_modules/@vscode/markdown-editor/dist/index.d.ts"
			],
			"@docode/observables": [
				"../node_modules/@docode/observables/dist/index.d.ts"
			]
		},
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"./**/*.ts"
	]
}
